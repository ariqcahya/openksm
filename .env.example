# OpenKSM Environment Template (copy to .env and replace placeholders with secure random values)

# Site / Ingress (:80 for local HTTP, or your domain e.g. openksm.example.org for HTTPS)
OPENKSM_SITE=:80
HTTP_PORT=8080
COOKIE_SECURE=false
CORS_ALLOW_ORIGINS=http://localhost:8080

# OpenKSM Application Images
OPENKSM_API_IMAGE=openksm/api:dev
OPENKSM_WEB_IMAGE=openksm/web:dev

# IDNBase & OpenKSM Secrets (generate with: openssl rand -hex 24 / 32)
POSTGRES_BOOTSTRAP_PASSWORD=replace_with_48_hex_chars
OPENKSM_REGISTRY_DB_PASSWORD=replace_with_48_hex_chars
MASTER_KEY_HEX=replace_with_64_hex_chars
GRAPHQL_JWT_SECRET=replace_with_64_hex_chars
